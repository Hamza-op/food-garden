/* AuraPOS Professional - Dark Mode Stylesheet */

/* ========== Global Styles ========== */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #0D0D0D;
}

QWidget {
    background-color: transparent;
    color: #EEEEEE;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

/* ========== Labels ========== */
QLabel {
    color: #EEEEEE;
    background-color: transparent;
    padding: 2px;
}

QLabel[heading="true"] {
    font-size: 28px;
    font-weight: bold;
    color: #00ADB5;
}

QLabel[subheading="true"] {
    font-size: 14px;
    color: #888888;
}

/* ========== Buttons ========== */
QPushButton {
    background-color: #1E1E1E;
    color: #EEEEEE;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 10px 20px;
    min-height: 18px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2A2A2A;
    border-color: #00ADB5;
}

QPushButton:pressed {
    background-color: #00ADB5;
    color: #0D0D0D;
}

QPushButton:disabled {
    background-color: #161616;
    color: #555555;
    border-color: #222222;
}

QPushButton[primary="true"] {
    background-color: #00ADB5;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00ADB5, stop:1 #00878D);
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00CED8, stop:1 #00ADB5);
}

QPushButton[primary="true"]:pressed {
    background-color: #007A80;
}

QPushButton[danger="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #E57373, stop:1 #CF6679);
    color: #0D0D0D;
    border: none;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
}

QPushButton[danger="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EF9A9A, stop:1 #E57373);
}

/* ========== Line Edits ========== */
QLineEdit {
    background-color: #1A1A1A;
    color: #EEEEEE;
    border: 2px solid #2A2A2A;
    border-radius: 8px;
    padding: 12px 16px;
    selection-background-color: #00ADB5;
    selection-color: #0D0D0D;
}

QLineEdit:focus {
    border-color: #00ADB5;
    background-color: #1E1E1E;
}

QLineEdit:disabled {
    background-color: #141414;
    color: #555555;
}

QLineEdit[search="true"] {
    font-size: 14px;
    padding: 10px 14px;
    border-radius: 10px;
    background-color: #1A1A1A;
}

QDateEdit {
    background-color: #1A1A1A;
    color: #EEEEEE;
    border: 2px solid #2A2A2A;
    border-radius: 8px;
    padding: 10px 14px;
}

QDateEdit:focus {
    border-color: #00ADB5;
    background-color: #1E1E1E;
}

/* ========== Combo Box ========== */
QComboBox {
    background-color: #1A1A1A;
    color: #EEEEEE;
    border: 2px solid #2A2A2A;
    border-radius: 8px;
    padding: 10px 16px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #00ADB5;
}

QComboBox:focus {
    border-color: #00ADB5;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #00ADB5;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    color: #EEEEEE;
    border: 1px solid #333333;
    border-radius: 6px;
    selection-background-color: #00ADB5;
    selection-color: #0D0D0D;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    min-height: 28px;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2A2A2A;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00ADB5;
    color: #0D0D0D;
}

/* ========== Spin Box ========== */
QSpinBox, QDoubleSpinBox {
    background-color: #1A1A1A;
    color: #EEEEEE;
    border: 2px solid #2A2A2A;
    border-radius: 8px;
    padding: 4px 24px 4px 8px; /* Extra right padding for buttons */
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #2A2A2A;
    border: none;
    width: 20px;
    border-radius: 4px;
    subcontrol-origin: border;
    padding: 0px; 
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 0px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-top: 0px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #00ADB5;
}

/* ========== CheckBox ========== */
QCheckBox {
    color: #CCCCCC;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #333333;
    background-color: #141414;
}

QCheckBox::indicator:hover {
    border-color: #00ADB5;
}

QCheckBox::indicator:checked {
    background-color: #00ADB5;
    border-color: #00ADB5;
}

/* ========== Tables ========== */
QTableWidget {
    background-color: #141414;
    color: #EEEEEE;
    border: 1px solid #252525;
    border-radius: 8px;
    gridline-color: transparent;
    alternate-background-color: #1A1A1A;
    outline: none;
}

QTableWidget[embedded="true"] {
    background-color: transparent;
    border: none;
    border-radius: 0px;
}

QTableWidget#historyTable::item {
    padding: 8px 10px;
    border-bottom: 1px solid #222222;
}

QTableWidget#historyTable::item:selected {
    background-color: #00ADB5;
    color: #0A0A0A;
}

QTableWidget::item {
    padding: 4px 8px; /* Reduced padding */
    border: none;
    border-bottom: 1px solid #252525;
    height: 38px; /* Matches python code */
}

QTableWidget::item:selected {
    background-color: #00ADB5;
    color: #000000;
}

QTableWidget::item:hover {
    background-color: #222222;
}

QHeaderView::section {
    background-color: #1E1E1E;
    color: #AAAAAA;
    padding: 8px 10px; /* Reduced padding */
    border: none;
    border-bottom: 2px solid #252525;
    font-weight: bold;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QTableWidget QTableCornerButton::section {
    background-color: #0D0D0D;
    border: none;
}

/* ========== Scroll Bars ========== */
QScrollBar:vertical {
    background-color: #141414;
    width: 6px; /* Slimmer scrollbar */
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #333333;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00ADB5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #141414;
    height: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #333333;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00ADB5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

/* ========== Tab Widget ========== */
QTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    background-color: #141414;
    border: 1px solid #252525;
    border-radius: 8px;
    margin-top: -1px;
    padding: 10px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #888888;
    padding: 12px 24px;
    border: none;
    border-bottom: 3px solid transparent;
    margin-right: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #00ADB5;
    border-bottom: 3px solid #00ADB5;
}

QTabBar::tab:hover:!selected {
    color: #CCCCCC;
    border-bottom: 3px solid #444444;
}

/* ========== Group Box ========== */
QGroupBox {
    background-color: #161616;
    border: 1px solid #252525;
    border-radius: 10px;
    margin-top: 20px;
    padding: 20px;
    padding-top: 30px;
    font-weight: bold;
}

QGroupBox::title {
    color: #00ADB5;
    subcontrol-origin: margin;
    left: 15px;
    top: 5px;
    padding: 0 8px;
    background-color: #161616;
}

/* ========== Frame ========== */
QFrame[card="true"] {
    background-color: #151515;
    border: 1px solid #2A2A2A;
    border-radius: 14px;
}

/* ========== Message Box ========== */
QMessageBox {
    background-color: #1E1E1E;
}

QMessageBox QLabel {
    color: #EEEEEE;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 90px;
    padding: 8px 16px;
}

/* ========== Tool Tip ========== */
QToolTip {
    background-color: #252525;
    color: #EEEEEE;
    border: 1px solid #00ADB5;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ========== Menu ========== */
QMenu {
    background-color: #141414;
    border: 1px solid #252525;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 10px 14px;
    border-radius: 8px;
    color: #EEEEEE;
}

QMenu::item:selected {
    background-color: #00ADB5;
    color: #0D0D0D;
}

/* ========== Progress Bar ========== */
QProgressBar {
    background-color: #1E1E1E;
    border: none;
    border-radius: 6px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ADB5, stop:1 #00CED8);
    border-radius: 6px;
}

/* ========== Dialog ========== */
QDialog {
    background-color: #141414;
}

/* ========== Form Layout Labels ========== */
QFormLayout QLabel {
    color: #AAAAAA;
    font-weight: 500;
}

/* ========== Component Specific Styles ========== */
#adminPageContent {
    background-color: transparent;
}

#adminScroll {
    background-color: transparent;
    border: none;
}

#loginRoot {
    background: qradialgradient(cx:0.5, cy:0.25, radius:1.1, fx:0.5, fy:0.25, stop:0 #111827, stop:0.45 #0D0D0D, stop:1 #0A0A0A);
}

#loginBrand {
    font-size: 44px;
    font-weight: 900;
    color: #00ADB5;
}

#loginSubtitle {
    font-size: 14px;
    color: #8A8A8A;
}

#loginCardTitle {
    font-size: 22px;
    font-weight: 800;
    color: #EEEEEE;
}

#loginError {
    color: #CF6679;
    font-size: 13px;
    font-weight: 600;
}

#loginGithub {
    color: #8A8A8A;
    font-size: 12px;
    padding-top: 6px;
}

#loginCard {
    border-radius: 18px;
}

#headerFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1A1A1A, stop:1 #111111);
    border: 1px solid #1E1E1E;
    border-radius: 16px;
}

#menuPanel, #cartPanel {
    background-color: #121212;
    border: 1px solid #1E1E1E;
    border-radius: 16px;
}

#themeBtn {
    background-color: transparent;
    color: #EEEEEE;
    border: 1px solid #2A2A2A;
    font-size: 18px;
    border-radius: 18px;
    padding: 0px;
    text-align: center;
}

#themeBtn:hover {
    border-color: #00ADB5;
    background-color: #1A1A1A;
}

#logoutBtn {
    background-color: transparent;
    color: #AAAAAA;
    border: 1px solid #2A2A2A;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 13px;
}

#logoutBtn:hover {
    color: #CF6679;
    border-color: #CF6679;
    background-color: #1A1A1A;
}

#userLabel {
    color: #9A9A9A;
    font-size: 13px;
}

QPushButton[nav="true"] {
    background-color: transparent;
    color: #AAAAAA;
    border: 1px solid #2A2A2A;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton[nav="true"]:hover {
    background-color: #1A1A1A;
    color: #EEEEEE;
    border-color: #00ADB5;
}

QPushButton[nav="true"][active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ADB5, stop:1 #00878D);
    color: #0A0A0A;
    border: none;
    font-weight: 800;
}

QPushButton[nav="true"][active="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00CED8, stop:1 #00ADB5);
}

#menuTitle, #cartTitle {
    font-size: 18px;
    font-weight: bold;
    color: #00ADB5;
}

#totalsFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1E1E1E, stop:1 #161616);
    border: 1px solid #252525;
    border-radius: 12px;
}

#divider {
    background-color: #333333;
}

#totalTitle {
    font-size: 16px;
    font-weight: bold;
    color: #EEEEEE;
}

#totalAmount {
    font-size: 24px;
    font-weight: bold;
    color: #00ADB5;
}

#logoLabel {
    font-size: 22px; 
    font-weight: bold; 
    color: #00ADB5; 
    letter-spacing: 1px;
}

#sectionTitle {
    font-size: 15px;
    font-weight: bold;
    color: #EEEEEE;
}

#statValue {
    font-size: 24px;
    font-weight: bold;
    color: #00ADB5;
}

#statTitle {
    color: #9A9A9A;
    font-size: 13px;
    font-weight: 700;
}

#statIcon {
    font-size: 18px;
    color: #B0B0B0;
}

#detailValue {
    font-size: 16px;
    font-weight: 700;
    color: #EEEEEE;
}

#detailTotal {
    font-size: 20px;
    font-weight: 900;
    color: #00ADB5;
}

QFrame[card="true"][statTone="primary"] {
    border: 1px solid #252525;
    border-left: 4px solid #00ADB5;
}

QFrame[card="true"][statTone="success"] {
    border: 1px solid #252525;
    border-left: 4px solid #4CAF50;
}

QFrame[card="true"][statTone="danger"] {
    border: 1px solid #252525;
    border-left: 4px solid #CF6679;
}


/* Menu Item Buttons */
QPushButton#menuItemBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #252525, stop:1 #1A1A1A);
    border: 1px solid #333333;
    border-radius: 12px;
    padding: 12px;
    text-align: center;
    color: #EEEEEE;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#menuItemBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2D2D2D, stop:1 #222222);
    border-color: #00ADB5;
}

QPushButton#menuItemBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #00ADB5, stop:1 #00878D);
    color: #0A0A0A;
    font-weight: bold;
}

/* Secondary / Tonal Buttons */
QPushButton[secondary="true"] {
    background-color: #1A1A1A;
    color: #EEEEEE;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 10px 16px;
    font-weight: 600;
}

QPushButton[secondary="true"]:hover {
    background-color: #222222;
    border-color: #00ADB5;
}

/* Bill Tab Buttons */
QPushButton[billTabActive="true"] {
    background-color: #00ADB5;
    color: #0A0A0A;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton[billTabActive="false"] {
    background-color: #1E1E1E;
    color: #888888;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

QPushButton[billTabActive="false"]:hover {
    background-color: #252525;
    color: #EEEEEE;
    border-color: #00ADB5;
}

/* New Bill Button */
QPushButton#newBillBtn {
    background-color: #1E1E1E;
    color: #00ADB5;
    border: 1px solid #333333;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
    padding: 0px;
    text-align: center;
}

QPushButton#newBillBtn:hover {
    background-color: #00ADB5;
    color: #0A0A0A;
}

/* Close Bill Button */
QPushButton#closeBillBtn {
    background-color: #1E1E1E;
    color: #CF6679;
    border: 1px solid #333333;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
    padding: 0px;
    text-align: center;
}

QPushButton#closeBillBtn:hover {
    background-color: #CF6679;
    color: #0A0A0A;
}


/* Action Buttons using ObjectName */
QPushButton#clearBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E57373, stop:1 #CF6679);
    color: #0D0D0D;
    border: none;
    border-radius: 10px;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#clearBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #EF9A9A, stop:1 #E57373);
}

QPushButton#payBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ADB5, stop:1 #00878D);
    color: #0D0D0D;
    border: none;
    border-radius: 10px;
    padding: 14px 30px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#payBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00CED8, stop:1 #00ADB5);
}

/* Remove Button in Cart */
QPushButton#removeBtn {
    background-color: transparent;
    color: #CF6679;
    border: 1px solid #CF6679;
    border-radius: 6px;
    font-size: 14px;
    padding: 6px;
    min-width: 24px;
}

QPushButton#removeBtn:hover {
    background-color: #CF6679;
    color: #0D0D0D;
}

/* Cart Quantity SpinBox */
QSpinBox#qtySpin {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 4px;
    color: #00ADB5;
    font-weight: bold;
    padding: 4px 8px;
    min-height: 25px;
    min-width: 60px;
}

QSpinBox#qtySpin:focus {
    border-color: #00ADB5;
    background-color: #252525;
}

QSpinBox#qtySpin::up-button, QSpinBox#qtySpin::down-button {
    background-color: #333333;
    width: 20px;
    border-radius: 2px;
    margin: 1px;
}

QSpinBox#qtySpin::up-button:hover, QSpinBox#qtySpin::down-button:hover {
    background-color: #00ADB5;
}
/* Hide arrows for cleaner look, user can type or use scroll */

/* ========== Admin Sidebar ========== */
#adminSidebar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #111111, stop:1 #121212);
    border: 1px solid #1E1E1E;
    border-radius: 16px;
    min-width: 230px;
    max-width: 230px;
}

#adminLogo {
    padding: 20px;
    border-bottom: 1px solid #1E1E1E;
    margin-bottom: 20px;
}

QPushButton#sidebarBtn {
    text-align: left;
    padding: 12px 16px;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    margin: 3px 10px;
    color: #888888;
    font-size: 15px;
    font-weight: 500;
}

QPushButton#sidebarBtn:hover {
    background-color: #1A1A1A;
    color: #EEEEEE;
}

QPushButton#sidebarBtn[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1A1A1A, stop:1 #121212);
    border: 1px solid #00ADB5;
    color: #00ADB5;
    font-weight: bold;
}

QPushButton#sidebarBtn[logout="true"] {
    color: #CF6679;
}

QPushButton#sidebarBtn[logout="true"]:hover {
    background-color: #1A1A1A;
    color: #FF5252;
}

/* ========== Admin Content Header ========== */
#contentHeader {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #111111, stop:1 #0D0D0D);
    border: 1px solid #1E1E1E;
    border-radius: 16px;
}

#headerTitle {
    font-size: 22px;
    font-weight: bold;
    color: #EEEEEE;
}

#headerSubtitle {
    color: #888888;
    font-size: 14px;
}

/* Admin panel title under logo */
#adminPanelTitle {
    font-size: 16px;
    font-weight: 700;
    color: #00ADB5;
}
