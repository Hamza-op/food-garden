/* AuraPOS Professional - Light Mode Stylesheet */

/* ========== Global Styles ========== */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
    color: #333333;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #F3F4F6; /* Softer gray background */
}

QWidget {
    background-color: transparent;
    color: #333333;
}

/* ========== Labels ========== */
QLabel {
    color: #333333;
    background-color: transparent;
    padding: 2px;
}

QLabel[heading="true"] {
    font-size: 28px;
    font-weight: bold;
    color: #008C94;
}

QLabel[subheading="true"] {
    font-size: 14px;
    color: #666666;
}

/* ========== Buttons ========== */
QPushButton {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #D1D5DB; /* Softer border */
    border-radius: 6px;
    padding: 10px 20px;
    min-height: 18px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border-color: #00ADB5;
}

QPushButton:pressed {
    background-color: #00ADB5;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00ADB5, stop:1 #008C94);
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00CED8, stop:1 #00ADB5);
}

QPushButton[primary="true"]:pressed {
    background-color: #007A80;
}

QPushButton[danger="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EF5350, stop:1 #D32F2F);
    color: #FFFFFF;
    border: none;
    font-weight: bold;
    padding: 12px 24px;
    border-radius: 8px;
}

QPushButton[danger="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EF9A9A, stop:1 #EF5350);
}

/* ========== Line Edits & Inputs ========== */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 10px 16px;
    selection-background-color: #00ADB5;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #00ADB5;
    background-color: #FFFFFF;
    border-width: 2px;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
}

QLineEdit[search="true"] {
    font-size: 15px;
    padding: 14px 20px;
    border-radius: 10px;
}

/* ========== Combo Box ========== */
QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #00ADB5;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    selection-background-color: #00ADB5;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    min-height: 28px;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #F3F4F6;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00ADB5;
    color: #FFFFFF;
}

/* ========== Spin Box Fixes (Ported from Dark Mode) ========== */
QSpinBox, QDoubleSpinBox {
    padding: 4px 24px 4px 8px; /* Extra right padding for buttons */
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #F3F4F6;
    border: none;
    width: 20px;
    border-radius: 4px;
    subcontrol-origin: border;
    padding: 0px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 0px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-top: 0px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #00ADB5;
}

/* ========== Tables ========== */
QTableWidget {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: transparent;
    alternate-background-color: #F9FAFB;
    outline: none;
}

QTableWidget::item {
    padding: 4px 8px; /* Compact padding */
    border: none;
    border-bottom: 1px solid #F3F4F6;
    height: 38px;
}

QTableWidget::item:selected {
    background-color: #E0F2F1; /* Light teal selection */
    color: #00695C;
}

QTableWidget::item:hover {
    background-color: #F3F4F6;
}

QHeaderView::section {
    background-color: #F9FAFB;
    color: #4B5563;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #E5E7EB;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QTableWidget QTableCornerButton::section {
    background-color: #FFFFFF;
    border: none;
}

/* ========== Scroll Bars (Slim & Modern) ========== */
QScrollBar:vertical {
    background-color: #F3F4F6;
    width: 6px;
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F3F4F6;
    height: 6px; /* Slimmer */
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #D1D5DB;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

/* ========== Tab Widget ========== */
QTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: -1px;
    padding: 10px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #6B7280;
    padding: 12px 24px;
    border: none;
    border-bottom: 3px solid transparent;
    margin-right: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #00ADB5;
    border-bottom: 3px solid #00ADB5;
}

QTabBar::tab:hover:!selected {
    color: #374151;
    border-bottom: 3px solid #E5E7EB;
}

/* ========== Group Box ========== */
QGroupBox {
    background-color: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    margin-top: 20px;
    padding: 20px;
    padding-top: 30px;
    font-weight: 600;
}

QGroupBox::title {
    color: #00ADB5;
    subcontrol-origin: margin;
    left: 15px;
    top: 5px;
    padding: 0 8px;
    background-color: #F9FAFB;
}

/* ========== Frames & Panels ========== */
QFrame[card="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 16px;
}

#headerFrame, #menuPanel, #cartPanel {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
}

#totalsFrame {
    background-color: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

#divider {
    background-color: #D1D5DB;
}

/* ========== Text Styles ========== */
#menuTitle, #cartTitle {
    font-size: 18px;
    font-weight: bold;
    color: #008C94;
}

#totalTitle {
    font-size: 16px;
    font-weight: bold;
    color: #374151;
}

#totalAmount {
    font-size: 24px;
    font-weight: bold;
    color: #00ADB5;
}

#logoLabel {
    font-size: 22px; 
    font-weight: bold; 
    color: #008C94; 
    letter-spacing: 1px;
}

#sectionTitle {
    font-size: 16px;
    font-weight: bold;
    color: #374151;
}

#statValue {
    font-size: 28px;
    font-weight: bold;
    color: #00ADB5;
}

/* ========== ToolTip ========== */
QToolTip {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #00ADB5;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ========== Progress Bar ========== */
QProgressBar {
    background-color: #E5E7EB;
    border: none;
    border-radius: 6px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ADB5, stop:1 #00CED8);
    border-radius: 6px;
}

/* ========== Custom Action Buttons ========== */
/* Reusing object names from main_window */

QPushButton#menuItemBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F9FAFB);
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 15px;
    color: #374151;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#menuItemBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F3F4F6, stop:1 #F9FAFB);
    border-color: #00ADB5;
}

QPushButton#menuItemBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #00ADB5, stop:1 #008C94);
    color: #FFFFFF;
    font-weight: bold;
}

/* Bill Tabs */
QPushButton[billTabActive="true"] {
    background-color: #00ADB5;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton[billTabActive="false"] {
    background-color: #FFFFFF;
    color: #6B7280;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

QPushButton[billTabActive="false"]:hover {
    background-color: #F3F4F6;
    color: #374151;
    border-color: #00ADB5;
}

/* New/Close Bill Buttons */
QPushButton#newBillBtn {
    background-color: #FFFFFF;
    color: #00ADB5;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#newBillBtn:hover {
    background-color: #00ADB5;
    color: #FFFFFF;
}

QPushButton#closeBillBtn {
    background-color: #FFFFFF;
    color: #EF5350;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#closeBillBtn:hover {
    background-color: #EF5350;
    color: #FFFFFF;
}

/* Action Buttons */
QPushButton#clearBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #EF5350, stop:1 #D32F2F);
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#clearBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #EF9A9A, stop:1 #EF5350);
}

QPushButton#payBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ADB5, stop:1 #008C94);
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 14px 30px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#payBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00CED8, stop:1 #00ADB5);
}
