    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
    padding: 16px;
}

/* ========== Message Box ========== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #333333;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 90px;
    padding: 8px 16px;
}

/* ========== Tool Tip ========== */
