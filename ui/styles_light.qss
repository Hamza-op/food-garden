/* AuraPOS Professional - Light Mode Stylesheet */

/* ========== Global Styles ========== */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
    color: #333333;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #F8F9FA;
}

QWidget {
    background-color: transparent;
    color: #333333;
}

/* ========== Labels ========== */
QLabel {
    color: #333333;
    background-color: transparent;
    padding: 2px;
}

QLabel[heading="true"] {
    font-size: 28px;
    font-weight: bold;
    color: #008C94;
}

QLabel[subheading="true"] {
    font-size: 14px;
    color: #666666;
}

/* ========== Buttons ========== */
QPushButton {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 6px;
    padding: 10px 20px;
    min-height: 18px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #EEEEEE;
    border-color: #00ADB5;
}

QPushButton:pressed {
    background-color: #00ADB5;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #E0E0E0;
    color: #AAAAAA;
    border-color: #D6D6D6;
}

QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00ADB5, stop:1 #008C94);
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00CED8, stop:1 #00ADB5);
}

QPushButton[primary="true"]:pressed {
    background-color: #007A80;
}

QPushButton[danger="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #E57373, stop:1 #D32F2F);
    color: #FFFFFF;
    border: none;
    font-weight: bold;
    padding: 12px 24px;
    border-radius: 8px;
}

QPushButton[danger="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EF9A9A, stop:1 #E57373);
}

/* ========== Line Edits ========== */
QLineEdit {
    background-color: #FFFFFF;
    color: #333333;
    border: 2px solid #DDDDDD;
    border-radius: 8px;
    padding: 12px 16px;
    selection-background-color: #00ADB5;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border-color: #00ADB5;
    background-color: #FAFAFA;
}

QLineEdit:disabled {
    background-color: #EEEEEE;
    color: #999999;
}

QLineEdit[search="true"] {
    font-size: 15px;
    padding: 14px 20px;
    border-radius: 10px;
    background-color: #FFFFFF;
}

/* ========== Combo Box ========== */
QComboBox {
    background-color: #FFFFFF;
    color: #333333;
    border: 2px solid #DDDDDD;
    border-radius: 8px;
    padding: 10px 16px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #00ADB5;
}

QComboBox:focus {
    border-color: #00ADB5;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #00ADB5;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 6px;
    selection-background-color: #00ADB5;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    min-height: 28px;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #EEEEEE;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00ADB5;
    color: #FFFFFF;
}

/* ========== Spin Box ========== */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #333333;
    border: 2px solid #DDDDDD;
    border-radius: 8px;
    padding: 10px 16px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #00ADB5;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #EEEEEE;
    border: none;
    width: 20px;
    border-radius: 4px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #00ADB5;
}

/* ========== Tables ========== */
QTableWidget {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #DDDDDD;
    border-radius: 8px;
    gridline-color: transparent;
    alternate-background-color: #FAFAFA;
    outline: none;
}

QTableWidget::item {
    padding: 12px 10px;
    border: none;
    border-bottom: 1px solid #F0F0F0;
}

QTableWidget::item:selected {
    background-color: #00ADB5;
    color: #FFFFFF;
}

QTableWidget::item:hover {
    background-color: #F0F0F0;
}

QHeaderView::section {
    background-color: #F8F9FA;
    color: #666666;
    padding: 12px 10px;
    border: none;
    border-bottom: 2px solid #E0E0E0;
    font-weight: bold;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QTableWidget QTableCornerButton::section {
    background-color: #FFFFFF;
    border: none;
}

/* ========== Scroll Bars ========== */
QScrollBar:vertical {
    background-color: #F0F0F0;
    width: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #CCCCCC;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00ADB5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F0F0F0;
    height: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #CCCCCC;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00ADB5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

/* ========== Tab Widget ========== */
QTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #DDDDDD;
    border-radius: 8px;
    margin-top: -1px;
    padding: 10px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #666666;
    padding: 12px 24px;
    border: none;
    border-bottom: 3px solid transparent;
    margin-right: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #00ADB5;
    border-bottom: 3px solid #00ADB5;
}

QTabBar::tab:hover:!selected {
    color: #333333;
    border-bottom: 3px solid #E0E0E0;
}

/* ========== Group Box ========== */
QGroupBox {
    background-color: #FBFBFB;
    border: 1px solid #DDDDDD;
    border-radius: 10px;
    margin-top: 20px;
    padding: 20px;
    padding-top: 30px;
    font-weight: bold;
}

QGroupBox::title {
    color: #00ADB5;
    subcontrol-origin: margin;
    left: 15px;
    top: 5px;
    padding: 0 8px;
    background-color: #FBFBFB;
}

/* ========== Frame ========== */
QFrame[card="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
    padding: 16px;
}

/* ========== Message Box ========== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #333333;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 90px;
    padding: 8px 16px;
}

/* ========== Tool Tip ========== */
QToolTip {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #00ADB5;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

/* ========== Progress Bar ========== */
QProgressBar {
    background-color: #E0E0E0;
    border: none;
    border-radius: 6px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ADB5, stop:1 #00CED8);
    border-radius: 6px;
}


/* ========== Tables ========== */
QTableWidget {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #DDDDDD;
    border-radius: 8px;
    gridline-color: #EEEEEE;
    alternate-background-color: #F9F9F9;
    selection-background-color: #00ADB5;
    selection-color: #FFFFFF;
}

QTableWidget::item {
    padding: 10px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #00ADB5;
    color: #FFFFFF;
}

QTableWidget::item:hover {
    background-color: #F0F0F0;
}

QHeaderView::section {
    background-color: #FFFFFF;
    color: #008C94;
    padding: 12px 10px;
    border: none;
    border-bottom: 2px solid #00ADB5;
    font-weight: bold;
    font-size: 13px;
}

QTableWidget QTableCornerButton::section {
    background-color: #FFFFFF;
    border: none;
}

/* ========== Scroll Bars ========== */
